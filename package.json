{
  "name": "openclaw-session-memory",
  "version": "0.1.0",
  "description": "Lossless raw FTS5 search + bookmarks + graph-lite memory for OCPlatform session JSONLs",
  "type": "module",
  "license": "MIT",
  "repository": "https://github.com/Daxitdon/openclaw-session-memory",
  "scripts": {
    "start": "node src/service.mjs",
    "backfill": "node scripts/backfill.mjs",
    "backup": "node scripts/backup.mjs",
    "bench": "node scripts/bench.mjs",
    "diagnose": "node scripts/diagnose.mjs",
    "entities:backfill": "node scripts/backfill-entities.mjs",
    "eval:search": "node scripts/eval-search.mjs",
    "eval:context": "node scripts/eval-context.mjs",
    "eval:search:heldout": "node scripts/eval-search.mjs evals/session-memory-heldout.jsonl",
    "eval:context:heldout": "node scripts/eval-context.mjs evals/context-heldout.jsonl"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "chokidar": "^3.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
